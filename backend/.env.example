# PulseOS Backend Environment Variables
# Copy this file to .env and provide your values before running.

# Postgres connection used by runtime
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Direct connection used for Prisma migrations and introspection
DIRECT_URL=postgresql://user:password@host:5432/dbname

# JWT auth
JWT_SECRET=your_jwt_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend/back-end URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# AI and external services
GROQ_API_KEY=your_groq_api_key
COHERE_API_KEY=your_cohere_api_key

# Google calendar integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Push notifications
VAPID_MAILTO=mailto:you@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Optional runtime
PORT=5000
NODE_ENV=development
