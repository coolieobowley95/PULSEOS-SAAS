# ─── PulseOS Frontend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values before running or building.
# VITE_ prefix is required for variables to be exposed to the browser.

# Required: Full URL to the backend API (no trailing slash)
# Development: http://localhost:5000/api
# Production:  https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api
